---
import '../styles/globals.css';
import { Image } from 'astro:assets';
import an_img from '../imgs/an.png';
import sh_logo from '../imgs/sh_logo.png';
---
<head>
	<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/an.ico" type="image/x-icon">
	<title>TripleAn</title>
</head>

<body style="text-align: center;">
<h1 class="nombre">TripleAn<Image class="pp" src={an_img} alt="" /></h1>

<div class="info" style="display: inline-block">
	<p>I code random things</p>
	<div class="plang">
		<h2 class="subsub">Programming languages</h2>
		<ul class="plangl" style="text-align: justify">
			<li><a>Python</a></li>
			<li><a>Rust</a></li>
			<li><a>Flutter/Dart</a></li>
   <li><a>C++ (not that good)</a></li>
		</ul>
	</div>
	<div class="act_lang" style="display: inline-block">
		<h2 class="subsub">Languages</h2>
		<ul class="alangl" style="text-align: justify">
			<li><a>Spanish</a></li>
			<li><a>English</a></li>
		</ul>
	</div>
    <div>
        <a>I hate frontend btw</a>
    </div>
    <div style="margin-top: 20px">
        <button class="ghbttn" onclick="window.location.href = 'https://github.com/triplean'">
            <a>Github Profile</a>
        </button>
    </div>
</div>
